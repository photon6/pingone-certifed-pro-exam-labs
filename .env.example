# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# PingOne environment (shared across all labs)
PINGONE_ENVIRONMENT_ID=your-environment-id
PINGONE_REGION=NA
# Regions: NA, EU, AP, CA

# ---------------------------------------------------------------------------
# Create one PingOne application per lab using the application type shown below.
# Paste client credentials here after creating each app in the PingOne admin console.
# ---------------------------------------------------------------------------

# Web app (OIDC) — User authentication
WEB_AUTH_CLIENT_ID=
WEB_AUTH_CLIENT_SECRET=

# Native / Mobile app — Mobile support (public client + PKCE)
MOBILE_CLIENT_ID=

# Single page app — SPA support (public client + PKCE)
SPA_CLIENT_ID=

# Worker / service app — API access (resource server validates tokens from this audience)
API_ACCESS_CLIENT_ID=
API_ACCESS_CLIENT_SECRET=

# Web app with refresh tokens — Long-running sessions
LONG_SESSION_CLIENT_ID=
LONG_SESSION_CLIENT_SECRET=

# Worker app — Machine-to-machine (client credentials grant)
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=

# Device app — Device Flow (RFC 8628)
DEVICE_FLOW_CLIENT_ID=

# Web app with CIBA enabled — Client Initiated Backchannel Authentication
CIBA_CLIENT_ID=
CIBA_CLIENT_SECRET=

# Worker app — Token Exchange (RFC 8693)
TOKEN_EXCHANGE_CLIENT_ID=
TOKEN_EXCHANGE_CLIENT_SECRET=
# Optional: target resource server client for subject_token exchange demos
TOKEN_EXCHANGE_TARGET_CLIENT_ID=
TOKEN_EXCHANGE_TARGET_CLIENT_SECRET=

# Web app with PAR / PKCE / DPoP options — Enhanced security controls
ENHANCED_SECURITY_CLIENT_ID=
ENHANCED_SECURITY_CLIENT_SECRET=
